  "transcript": [
    {
      "start": 0.34,
      "end": 535.78,
      "text": "Hey Donington!"
    },
    {
      "start": 535.78,
      "end": 577.78,
      "text": "Come on, come on!"
    },
    {
      "start": 577.78,
      "end": 2174.1,
      "text": "Accept, from Donington 1984, Peter Belters, Udo Derkschneider, Wolf Hoffmann, Stefan Kaufmann, and Jörg Fischer. Excellent band."
    },
    {
      "start": 2174.1,
      "end": 2176.1,
      "text": "We have Y&T in about 25 minutes time."
    },
    {
      "start": 2177.1,
      "end": 2193.31,
      "text": "6 minutes to 11."
    },
    {
      "start": 2193.31,
      "end": 2198.31,
      "text": "Okay, it's time for Lie Back and Enjoy, from, I'm still singing, Balls to the Wall."
    },
    {
      "start": 2198.31,
      "end": 2203.52,
      "text": "...and we'll accept, so I'll now calm down."
    },
    {
      "start": 2203.52,
      "end": 2209.5,
      "text": "time to lie back and enjoy it but we invite people to write in and suggest 25 minutes"
    },
    {
      "start": 2209.5,
      "end": 2214.87,
      "text": "well actually more like 15 to 20 minutes of music for this little feature for lie back and enjoy"
    },
    {
      "start": 2214.87,
      "end": 2222.3,
      "text": "bbc radio one the friday rock show and now let's get back to some more music from donnington 1984"
    },
    {
      "start": 2222.3,
      "end": 2232.06,
      "text": "y and t introduced like this this is one hell of a day and to make it better would you welcome"
    },
    {
      "start": 2232.06,
      "end": 2232.8,
      "text": "from the States,"
    },
    {
      "start": 2233.22,
      "end": 2234.84,
      "text": "Y&T!"
    },
    {
      "start": 2236.36,
      "end": 3994.5,
      "text": "Catty, Phil Kennemore,"
    },
    {
      "start": 3994.7,
      "end": 3995.4,
      "text": "Leonard Hayes,"
    },
    {
      "start": 3995.52,
      "end": 3997.68,
      "text": "Y&T from Donington, 1984."
    },
    {
      "start": 4019.47,
      "end": 4020.59,
      "text": "It is 12 minutes to 12."
    },
    {
      "start": 4021.11,
      "end": 4022.21,
      "text": "Here are Slade."
    },
    {
      "start": 4022.65,
      "end": 4702.94,
      "text": "Now signed to a major,"
    },
    {
      "start": 4703.1,
      "end": 4703.76,
      "text": "signed to RCA."
    },
    {
      "start": 4703.92,
      "end": 4705.18,
      "text": "The band from the Midlands"
    },
    {
      "start": 4705.18,
      "end": 4706.0,
      "text": "are what they call Shy."
    },
    {
      "start": 4706.16,
      "end": 4706.92,
      "text": "Excellent band,"
    },
    {
      "start": 4706.98,
      "end": 4707.46,
      "text": "they really are."
    },
    {
      "start": 4707.82,
      "end": 4708.32,
      "text": "Track is called"
    },
    {
      "start": 4708.32,
      "end": 4709.06,
      "text": "Hold On To Your Love."
    },
    {
      "start": 4709.14,
      "end": 4709.84,
      "text": "Before that you heard"
    },
    {
      "start": 4709.84,
      "end": 4711.1,
      "text": "Autograph from their album"
    },
    {
      "start": 4711.1,
      "end": 4711.8,
      "text": "Sign In Please."
    },
    {
      "start": 4711.94,
      "end": 4713.16,
      "text": "The track was The Deep End."
    },
    {
      "start": 4713.86,
      "end": 4714.58,
      "text": "Prior to that"
    },
    {
      "start": 4714.58,
      "end": 4716.2,
      "text": "from the Rose Gallery album"
    },
    {
      "start": 4716.2,
      "end": 4717.64,
      "text": "Slade and Little Sheila."
    },
    {
      "start": 4717.64,
      "end": 4723.84,
      "text": "I hope you enjoyed Accepting Y&T from Donington."
    },
    {
      "start": 4724.46,
      "end": 4727.14,
      "text": "The Fighting Rock Show is a Tony Wilson production."
    },
    {
      "start": 4729.5,
      "end": 4732.06,
      "text": "Driving over the weekend, take care."
    },
    {
      "start": 4732.34,
      "end": 4735.68,
      "text": "Lots of people on the road, please do take care."
    },
    {
      "start": 4736.44,
      "end": 4738.56,
      "text": "Following the Midnight Pips on Medium Wave, the news,"
    },
    {
      "start": 4738.98,
      "end": 4740.54,
      "text": "on FM Stereo, Radio 2."
    },
    {
      "start": 4741.22,
      "end": 4748.85,
      "text": "Have a good holiday, if you're having one,"
    },
    {
      "start": 4748.99,
      "end": 4750.45,
      "text": "and do take great care of yourself."
    },
    {
      "start": 4750.59,
      "end": 4752.35,
      "text": "I'm Tommy Vance. God bless."
    }
  ]
